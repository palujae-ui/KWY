# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 원본 프로필 사진 (5.7MB) — public/portrait-*.{webp,jpg} 로 리사이즈해 사용, 저장소에는 포함하지 않음
/assets/

# 이력서·논문·기고 원본 자료 및 변환 MD — 개인정보(생년월일·자택주소·개인 휴대폰) 포함.
# 직업적 정보는 src/data/*.ts 로 이미 추출됨. 저장소·배포에서 제외한다. (원본은 로컬 보관)
/public/논문 보고서 일부/
/public/이력서 및 신문인터뷰, 기고문_일부/
/public/*.pdf
/public/*.zip
